#!/bin/sh
# Morde task commits are one task per commit: the subject must read "Txx: <description>".
# Merge and Revert commits (upstream merges) pass through unchanged.
if [ -z "$1" ]; then
  echo "commit-msg: rejected: no message file given" >&2
  exit 1
fi
subject=$(sed -n '1p' "$1")
case "$subject" in
  Merge*|Revert*) exit 0 ;;
esac
if printf '%s' "$subject" | grep -Eq '^T[0-9]+: .+'; then
  exit 0
fi
echo "commit-msg: rejected: subject must be 'Txx: <description>', e.g. 'T13: add git hooks'" >&2
echo "commit-msg: got: '$subject'" >&2
echo "commit-msg: Merge/Revert commits pass through; bypass once with --no-verify" >&2
exit 1
